# 多阶段构建 - 生产环境优化版本
# 阶段1: 构建阶段
FROM golang:1.24-alpine AS builder

# 设置工作目录
WORKDIR /build

# 安装必要的构建工具
RUN apk add --no-cache git gcc g++ libc-dev

# 设置Go环境变量
ENV GOPROXY=https://goproxy.cn,direct \
    GO111MODULE=on \
    CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=amd64

# 复制go mod文件
COPY go.mod go.sum ./

# 下载依赖
RUN go mod download

# 复制源代码
COPY . .

# 构建应用（启用优化）
RUN go build -ldflags="-w -s" -a -installsuffix cgo -o shadmin main.go

# 阶段2: 运行阶段
FROM alpine:latest

# 设置时区
RUN apk add --no-cache ca-certificates tzdata wget && \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

# 创建应用目录
WORKDIR /app

# 从构建阶段复制二进制文件
COPY --from=builder /build/shadmin /app/shadmin

# 复制配置文件和静态资源（如果需要）
COPY config/ /app/config/
COPY static/ /app/static/

# 创建必要的目录
RUN mkdir -p /app/temp/logs

# 暴露端口
EXPOSE 8000

# 设置可执行权限
RUN chmod +x /app/shadmin

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8000/api/v1/health || exit 1

# 运行应用
CMD ["/app/shadmin", "server", "-c", "/app/config/settings.prod.yml"]
